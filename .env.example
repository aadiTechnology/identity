APP_ENV=production
ISSUER=https://id.aadiprojecttracker.aaditechnology.com
DATABASE_URL=postgresql+psycopg://identity:change-me@localhost:15440/identity
COOKIE_SECURE=true
# optional: RSA private key in PEM (use \n for newlines). Leave empty to generate one and keep it in the database.
SIGNING_KEY_PEM=
# Optional Fernet key: encrypts webhook secrets and signing keys in the database (see docs/Production_Runbook.md section 11). Keep it in Coolify AND a password manager.
SECRETS_KEY=
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aaditechnology.com
